<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="privilege_school_finance" model="res.groups.privilege">
            <field name="name">School Finance Control</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_school_finance_entry" model="res.groups">
            <field name="name">Finance Entry User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_school_finance"/>
            <field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_school_finance_accountant" model="res.groups">
            <field name="name">School Accountant</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_school_finance"/>
            <field name="implied_ids" eval="[
                Command.link(ref('group_school_finance_entry')),
                Command.link(ref('account.group_account_user'))
            ]"/>
        </record>

        <record id="group_school_finance_reviewer" model="res.groups">
            <field name="name">Finance Reviewer</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="privilege_school_finance"/>
            <field name="implied_ids" eval="[Command.link(ref('group_school_finance_accountant'))]"/>
        </record>

        <record id="group_school_finance_approver" model="res.groups">
            <field name="name">Finance Approver</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="privilege_school_finance"/>
            <field name="implied_ids" eval="[Command.link(ref('group_school_finance_reviewer'))]"/>
        </record>

        <record id="group_school_finance_manager" model="res.groups">
            <field name="name">School Finance Manager</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="privilege_school_finance"/>
            <field name="implied_ids" eval="[
                Command.link(ref('group_school_finance_approver')),
                Command.link(ref('account.group_account_manager'))
            ]"/>
            <field name="user_ids" eval="[
                Command.link(ref('base.user_root')),
                Command.link(ref('base.user_admin'))
            ]"/>
        </record>
    </data>
</odoo>

