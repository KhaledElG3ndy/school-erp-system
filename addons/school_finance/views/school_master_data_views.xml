<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_academic_year_list" model="ir.ui.view">
        <field name="name">school.academic.year.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_school_academic_year_form" model="ir.ui.view">
        <field name="name">school.academic.year.form</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Open" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" class="oe_highlight" invisible="state != 'open'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="school_demo_data" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_school_department_list" model="ir.ui.view">
        <field name="name">school.department.list</field>
        <field name="model">school.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_school_department_form" model="ir.ui.view">
        <field name="name">school.department.form</field>
        <field name="model">school.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="analytic_account_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                        <field name="school_demo_data" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_department" model="ir.actions.act_window">
        <field name="name">Departments / Cost Centers</field>
        <field name="res_model">school.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_school_fee_type_list" model="ir.ui.view">
        <field name="name">school.fee.type.list</field>
        <field name="model">school.fee.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="frequency"/>
                <field name="default_amount"/>
                <field name="income_account_id"/>
                <field name="department_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_school_fee_type_form" model="ir.ui.view">
        <field name="name">school.fee.type.form</field>
        <field name="model">school.fee.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="frequency"/>
                            <field name="default_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="income_account_id"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="school_demo_data" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_fee_type" model="ir.actions.act_window">
        <field name="name">Fee Types</field>
        <field name="res_model">school.fee.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_school_installment_plan_list" model="ir.ui.view">
        <field name="name">school.installment.plan.list</field>
        <field name="model">school.installment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="payment_term_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_school_installment_plan_form" model="ir.ui.view">
        <field name="name">school.installment.plan.form</field>
        <field name="model">school.installment.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="payment_term_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                        <field name="school_demo_data" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Installment percentages and due-date rules are maintained in the linked standard Odoo payment term.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_installment_plan" model="ir.actions.act_window">
        <field name="name">Installment Plans</field>
        <field name="res_model">school.installment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

