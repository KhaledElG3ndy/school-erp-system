<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_school_finance" model="ir.ui.view">
        <field name="name">account.move.form.school.finance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_school_submit" string="Submit for Review" type="object"
                        class="oe_highlight"
                        invisible="not school_approval_required or state != 'draft' or school_approval_state not in ('draft', 'returned', 'rejected')"/>
                <button name="action_school_review" string="Finance Review" type="object"
                        class="oe_highlight" groups="school_finance.group_school_finance_reviewer"
                        invisible="not school_approval_required or state != 'draft' or school_approval_state != 'submitted'"/>
                <button name="action_school_approve" string="Finance Approve" type="object"
                        class="oe_highlight" groups="school_finance.group_school_finance_approver"
                        invisible="not school_approval_required or state != 'draft' or school_approval_state != 'reviewed'"/>
                <button name="action_school_reject" string="Reject" type="object"
                        groups="school_finance.group_school_finance_reviewer"
                        invisible="not school_approval_required or state != 'draft' or school_approval_state not in ('submitted', 'reviewed')"/>
                <button name="action_school_return" string="Return for Correction" type="object"
                        groups="school_finance.group_school_finance_reviewer"
                        invisible="not school_approval_required or state != 'draft' or school_approval_state not in ('submitted', 'reviewed', 'approved')"/>
                <field name="school_approval_state" widget="statusbar"
                       statusbar_visible="draft,submitted,reviewed,approved"
                       invisible="not school_approval_required"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_school_installments" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not school_is_fee_invoice or state != 'posted'">
                    <span class="o_stat_text">Installments</span>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="school_fee_type_id" optional="show"/>
                <field name="school_department_id" optional="show"/>
                <field name="school_is_grant" optional="hide"/>
                <field name="school_discount_reason" optional="hide"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="School Finance" name="school_finance"
                      invisible="move_type not in ('out_invoice', 'out_refund') and not school_student_id">
                    <group>
                        <group>
                            <field name="school_student_id" readonly="state != 'draft'"/>
                            <field name="school_guardian_id" readonly="state != 'draft'"/>
                            <field name="school_academic_year_id" readonly="state != 'draft'"/>
                            <field name="school_term" readonly="state != 'draft'"/>
                            <field name="school_installment_plan_id" readonly="state != 'draft'"/>
                            <field name="school_fee_batch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="school_refund_reason"
                                   invisible="move_type != 'out_refund'"
                                   required="move_type == 'out_refund' and school_student_id"
                                   readonly="state != 'draft'"/>
                            <field name="school_demo_data" readonly="1"/>
                            <field name="school_amount_in_process" readonly="1" invisible="state != 'posted'"/>
                            <field name="school_collection_residual" readonly="1" invisible="state != 'posted'"/>
                        </group>
                    </group>
                    <field name="school_installment_line_ids" readonly="1"
                           invisible="state != 'posted'">
                        <list create="false" delete="false">
                            <field name="date_maturity"/>
                            <field name="debit"/>
                            <field name="credit"/>
                            <field name="amount_residual"/>
                            <field name="reconciled"/>
                        </list>
                    </field>
                </page>
                <page string="Finance Approval" name="school_approval"
                      invisible="not school_approval_required">
                    <group>
                        <group>
                            <field name="school_submitted_by_id" readonly="1"/>
                            <field name="school_submitted_date" readonly="1"/>
                            <field name="school_reviewed_by_id" readonly="1"/>
                            <field name="school_reviewed_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="school_approved_by_id" readonly="1"/>
                            <field name="school_approved_date" readonly="1"/>
                            <field name="school_approval_reason"
                                   placeholder="Required before Reject or Return for Correction."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_school_finance" model="ir.ui.view">
        <field name="name">account.move.search.school.finance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="school_student_id"/>
                <field name="school_guardian_id"/>
                <field name="school_academic_year_id"/>
                <filter name="school_fee_invoices" string="School Fee Invoices"
                        domain="[('school_is_fee_invoice', '=', True)]"/>
                <filter name="school_pending_review" string="Pending Finance Review"
                        domain="[('school_approval_required', '=', True), ('school_approval_state', '=', 'submitted')]"/>
                <filter name="school_pending_approval" string="Pending Finance Approval"
                        domain="[('school_approval_required', '=', True), ('school_approval_state', '=', 'reviewed')]"/>
                <separator/>
                <filter name="group_school_student" string="Student" context="{'group_by': 'school_student_id'}"/>
                <filter name="group_school_guardian" string="Guardian" context="{'group_by': 'school_guardian_id'}"/>
                <filter name="group_school_year" string="Academic Year" context="{'group_by': 'school_academic_year_id'}"/>
                <filter name="group_school_term" string="Academic Period" context="{'group_by': 'school_term'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_school_invoices" model="ir.actions.act_window">
        <field name="name">Student Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('school_student_id', '!=', False)]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'search_default_school_fee_invoices': 1
        }</field>
    </record>
</odoo>
