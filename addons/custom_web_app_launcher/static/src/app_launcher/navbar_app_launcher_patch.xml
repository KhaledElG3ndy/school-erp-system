<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-name="custom_web_app_launcher.NavBarAppsMenuPatch"
        t-inherit="web.NavBar.AppsMenu"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]" position="replace">
            <div t-if="!isScopedApp" class="o_navbar_apps_menu">
                <button
                    type="button"
                    class="o_menu_toggle border-0 bg-transparent"
                    data-hotkey="h"
                    title="Home Menu"
                    t-on-click.prevent.stop="openCustomAppLauncher"
                >
                    <i class="oi oi-apps"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
